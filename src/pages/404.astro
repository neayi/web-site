---
import Base from '../layouts/Base.astro';
---

<Base lang="fr" title="Page introuvable" description="Cette page n'existe pas ou a été déplacée." alternates={{ fr: '/', en: '/en/' }} noindex>
  <div class="wrap notfound">
    <h1>Page introuvable</h1>
    <p>Cette page n'existe pas ou a été déplacée. <a href="/">Retour à l'accueil</a></p>
    <p lang="en">This page does not exist or has moved. <a href="/en/">Back to the English home page</a></p>
  </div>
</Base>

<style>
  .notfound {
    padding-block: 64px 0;
  }
  h1 {
    font-size: 2.2rem;
  }
</style>
