---
import '@fontsource/comfortaa/700.css';
import '@fontsource-variable/nunito-sans';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { HUBSPOT_PORTAL_ID, MATOMO } from '../config';
import { getImage } from 'astro:assets';
import { htmlLang, locales, type Locale } from '../i18n/ui';
import ogImageFr from '../assets/images/opengraph-neayi.png';
import ogImageEn from '../assets/images/opengraph-neayi-en.png';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** URL de la même page dans chaque langue, pour le sélecteur et les balises hreflang. */
  alternates: Partial<Record<Locale, string>>;
  noindex?: boolean;
  /** Pour les articles : date de publication et auteur (og:type « article »). */
  article?: { published?: Date; author?: string };
}

const { lang, title, description, alternates, noindex = false, article } = Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
// Le nom du site n'est ajouté que s'il n'apparaît pas déjà dans le titre.
const fullTitle = title.includes('Neayi') ? title : `${title} · Neayi`;

// Image de partage (réseaux sociaux, messageries) : un visuel par langue, converti en JPEG.
const ogSource = { fr: ogImageFr, en: ogImageEn }[lang];
const og = await getImage({ src: ogSource, format: 'jpg', quality: 85, width: ogSource.width });
const ogImage = new URL(og.src, site).href;
const ogImageAlt = {
  fr: 'Neayi : rendre les savoirs agroécologiques accessibles à tous',
  en: 'Neayi: making agroecological knowledge open to everyone',
}[lang];
const ogLocale = (l: Locale) => htmlLang[l].replace('-', '_');
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      Object.entries(alternates).map(
        ([l, href]) => href && <link rel="alternate" hreflang={l} href={new URL(href, site).href} />,
      )
    }
    {alternates.fr && <link rel="alternate" hreflang="x-default" href={new URL(alternates.fr, site).href} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="Neayi" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(og.attributes.width ?? ogSource.width)} />
    <meta property="og:image:height" content={String(og.attributes.height ?? ogSource.height)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={ogLocale(lang)} />
    {
      locales
        .filter((l) => l !== lang && alternates[l])
        .map((l) => <meta property="og:locale:alternate" content={ogLocale(l)} />)
    }
    {article?.published && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.author && <meta property="article:author" content={article.author} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {
      MATOMO.siteId !== null && (
        <script is:inline define:vars={{ url: MATOMO.url, siteId: MATOMO.siteId }}>
          var _paq = (window._paq = window._paq || []);
          _paq.push(['trackPageView']);
          _paq.push(['enableLinkTracking']);
          _paq.push(['setTrackerUrl', url + 'matomo.php']);
          _paq.push(['setSiteId', String(siteId)]);
          var g = document.createElement('script');
          g.async = true;
          g.src = url + 'matomo.js';
          document.head.appendChild(g);
        </script>
      )
    }
    <script is:inline async defer id="hs-script-loader" src={`//js.hs-scripts.com/${HUBSPOT_PORTAL_ID}.js`}></script>
  </head>
  <body>
    <Header lang={lang} alternates={alternates} />
    <main id="contenu">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
