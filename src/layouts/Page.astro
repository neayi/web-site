---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import { htmlLang, t, type Locale } from '../i18n/ui';
import { pageLang, pagePath, urlFor } from '../lib/urls';

interface Props {
  entry: CollectionEntry<'pages'>;
  lang: Locale;
  alternates: Partial<Record<Locale, string>>;
}

const { entry, lang, alternates } = Astro.props;
const { title, description, eyebrow, cta, parent, date, author, image, imageAlt } = entry.data;

const parentHref = parent ? await urlFor(parent, lang) : undefined;
const parentTitle = parent
  ? (await getCollection('pages', (p) => p.data.key === parent && pageLang(p) === lang))[0]?.data.title
  : undefined;
const children = (
  await getCollection('pages', (p) => p.data.parent === entry.data.key && pageLang(p) === lang)
).sort((a, b) => (a.data.date?.getTime() ?? 0) - (b.data.date?.getTime() ?? 0));
const formatDate = (d: Date) => d.toLocaleDateString(htmlLang[lang], { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base lang={lang} title={title} description={description} alternates={alternates}>
  <article class="wrap page">
    <header>
      {parentHref && <p class="eyebrow"><a href={parentHref}>← {parentTitle}</a></p>}
      {!parentHref && eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      {
        (author || date) && (
          <p class="byline">
            {author && `${t(lang, 'page.by')} ${author}`}
            {author && date && ' · '}
            {date && <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>}
          </p>
        )
      }
    </header>
    {image && <Image class="cover" src={image} alt={imageAlt ?? ''} widths={[435, 870]} sizes="(max-width: 700px) 100vw, 680px" />}
    <div class="prose">
      <slot />
    </div>
    {
      children.length > 0 && (
        <aside class="children">
          <h2>{t(lang, 'page.children')}</h2>
          <ul>
            {children.map((c) => (
              <li>
                <a href={pagePath(c)}>
                  {c.data.image && <Image class="thumb" src={c.data.image} alt="" widths={[240, 480]} sizes="240px" />}
                  <span class="text">
                    <strong>{c.data.title}</strong><br>
                    <span class="desc">{c.data.description}</span>
                    <span class="more">{t(lang, 'page.read')} →</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
    {cta && <p class="cta"><a class="btn btn-action" href={cta.href}>{cta.label}</a></p>}
  </article>
</Base>

<style>
  .page {
    padding-block: 48px 0;
  }
  header {
    max-width: 68ch;
    margin-bottom: 32px;
  }
  .eyebrow {
    margin: 0 0 8px;
    font-weight: 800;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--neayi-green);
  }
  h1 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    margin: 0 0 14px;
  }
  .lead {
    font-size: 1.15rem;
    color: var(--muted);
    margin: 0;
  }
  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }
  .eyebrow a:hover {
    text-decoration: underline;
  }
  .byline {
    margin: 14px 0 0;
    font-size: 0.92rem;
    color: var(--muted);
  }
  .cover {
    display: block;
    width: 100%;
    max-width: 68ch;
    height: auto;
    border-radius: 18px;
    margin-bottom: 32px;
  }
  .prose :global(img) {
    border-radius: 12px;
    margin-block: 8px 0;
  }
  .prose :global(figure.chart) {
    margin: 24px 0;
  }
  .prose :global(figure.chart iframe) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    border: 0;
    border-radius: 12px;
    background: var(--surface);
  }
  .prose :global(figure.chart figcaption) {
    margin-top: 6px;
    font-size: 0.9rem;
    font-style: italic;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .prose :global(blockquote) {
    margin: 1.5em 0;
    padding: 4px 0 4px 20px;
    border-left: 4px solid var(--neayi-green);
    font-size: 1.1rem;
    color: var(--ink-strong);
  }
  .prose :global(img[alt^='LinkedIn']) {
    display: inline-block;
    width: 20px;
    height: 20px;
    margin: 0 0 0 4px;
    border-radius: 3px;
    vertical-align: -3px;
  }
  .prose :global(img + em),
  .prose :global(p:has(> img) + p > em:only-child) {
    font-size: 0.9rem;
    color: var(--muted);
  }
  .children {
    margin-top: 56px;
  }
  .children h2 {
    font-size: 1.3rem;
    margin: 0 0 16px;
  }
  .children ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 18px;
    max-width: 900px;
  }
  .children a {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--surface);
    border-radius: 18px;
    box-shadow: var(--shadow-card);
    overflow: hidden;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .children a:hover {
    transform: translateY(-2px);
    box-shadow: 0 1px 0 rgb(37 48 44 / 7%), 0 16px 32px -18px rgb(37 48 44 / 45%);
  }
  .children .thumb {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    object-fit: cover;
  }
  .children .text {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 20px 18px;
    flex: 1;
  }
  .children strong {
    font: 700 1.1rem var(--font-title);
    color: var(--ink-strong);
  }
  .children .desc {
    font-size: 0.95rem;
    color: var(--muted);
  }
  .children .more {
    margin-top: auto;
    padding-top: 6px;
    font-weight: 800;
    font-size: 0.92rem;
    color: var(--neayi-blue);
  }
  .cta {
    margin-top: 32px;
  }
</style>
